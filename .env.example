# Example environment configuration
# Copy this file to .env and adjust the URLs for your environment

# Development (local)
VITE_API_URL=http://localhost:8080/
VITE_HISTORICAL_API_URL=http://localhost:5555/

# Production examples:
# VITE_API_URL=http://192.168.1.100:8080/
# VITE_HISTORICAL_API_URL=http://192.168.1.100:5555/
# 
# Or with domain:
# VITE_API_URL=https://api.yourdomain.com:8080/
# VITE_HISTORICAL_API_URL=https://historical.yourdomain.com:5555/
# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
